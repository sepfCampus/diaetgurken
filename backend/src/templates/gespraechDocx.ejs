<!DOCTYPE html>
<html lang="de">

<head>
    <meta charset="UTF-8">
    <title>Gesprächsprotokoll</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            font-size: 11pt;
            line-height: 1.4;
            color: #222222;
            margin: 20px;
            background-color: #ffffff;
        }

        .header {
            margin-bottom: 20px;
        }

        .header h1 {
            margin: 0 0 6px 0;
            font-size: 18pt;
            color: #1f4e79;
        }

        .header p {
            margin: 2px 0 0 0;
            color: #555555;
        }

        .logo {
            width: 160px;
            height: auto;
            display: block;
            margin: 0 0 16px auto;
        }

        .meta-info,
        .section {
            padding: 10px;
            margin-bottom: 16px;
            border: 1px solid #d1d5db;
            background-color: #f8fafc;
        }

        .section h2 {
            margin: 0 0 10px 0;
            font-size: 14pt;
            color: #0f4a74;
        }

        .field {
            margin-bottom: 8px;
        }

        .field-label {
            display: block;
            font-weight: bold;
            color: #111827;
            margin-bottom: 2px;
        }

        .field-value {
            display: block;
            color: #333333;
        }

        .list-item {
            margin-bottom: 6px;
            color: #333333;
        }

        .subsection {
            margin-bottom: 12px;
            padding-left: 8px;
        }

        .subsection h3 {
            margin: 0 0 6px 0;
            font-size: 12.5pt;
            color: #111827;
        }

        .footer {
            margin-top: 20px;
            color: #6b7280;
            font-size: 10pt;
        }
    </style>
</head>

<body>
    <% if (logoSrc) { %>
        <img src="<%= logoSrc %>" alt="Logo" class="logo">
        <% } %>

            <div class="header">
                <h1>Gesprächsprotokoll</h1>
                <p>Exportiert am: <%= new Date(generatedAt).toLocaleString('de-DE') %>
                </p>
            </div>

            <div class="meta-info">
                <div class="field">
                    <span class="field-label">Klient</span>
                    <span class="field-value">
                        <%= akte?.klarname?.name || 'Unbekannt' %>
                    </span>
                </div>
                <div class="field">
                    <span class="field-label">Gesprächsdatum</span>
                    <span class="field-value">
                        <%= new Date(gespraech.datum).toLocaleDateString('de-DE') %>
                    </span>
                </div>
            </div>

            <% function formatLabel(key) { const map={ compliance: 'Compliance' , motivation: 'Motivation' ,
                risikoFaktoren: 'Risikofaktoren' , erfolg: 'Erfolg' , notizen: 'Notizen' , ziel: 'Ziel' , ziele: 'Ziele'
                , titel: 'Titel' , beschreibung: 'Beschreibung' , status: 'Status' , datum: 'Datum' , name: 'Name' ,
                vorname: 'Vorname' , nachname: 'Nachname' , email: 'E-Mail' , telefon: 'Telefon' , adresse: 'Adresse' ,
                telefonnummer: 'Telefonnummer' , diagnosis: 'Diagnose' , diagnosen: 'Diagnosen' ,
                wahrnehmung: 'Wahrnehmung' , bemerkung: 'Bemerkung' , bemerkungen: 'Bemerkungen' ,
                kommentar: 'Kommentar' , kommentare: 'Kommentare' , outcome: 'Outcome' , kategorie: 'Kategorie' ,
                score: 'Score' , }; if (map[key]) return map[key]; return key.replace(/([A-Z])/g, ' $1'
                ).replace(/_/g, ' ' ).replace(/^./, str=> str.toUpperCase());
                }

                function formatValue(value) {
                if (value === null || value === undefined) {
                return 'Nicht angegeben';
                }

                if (Array.isArray(value)) {
                if (value.length === 0) return '-';
                return value
                .map(item => {
                if (item === null || item === undefined) return '';
                if (typeof item === 'object') {
                if (typeof item.toString === 'function' && item.toString() !== '[object Object]') {
                return item.toString();
                }
                return JSON.stringify(item);
                }
                return item;
                })
                .filter(Boolean)
                .join(', ');
                }

                if (typeof value === 'object') {
                const entries = Object.entries(value);
                if (entries.length === 0) return '-';
                return entries
                .map(([k, v]) => `${formatLabel(k)}: ${formatValue(v)}`)
                .join(', ');
                }

                return value;
                }

                function renderObject(obj) {
                if (!obj || Object.keys(obj).length === 0) {
                %>
                <div class="field">
                    <span class="field-value">Keine Daten vorhanden</span>
                </div>
                <% } else { Object.entries(obj).forEach(function(entry) { %>
                    <div class="field">
                        <span class="field-label">
                            <%= formatLabel(entry[0]) %>
                        </span>
                        <span class="field-value">
                            <%= formatValue(entry[1]) %>
                        </span>
                    </div>
                    <% }); } } %>

                        <% if (gespraech.formMetaData && Array.isArray(gespraech.formMetaData.fields) &&
                            gespraech.formMetaData.fields.length> 0) { %>
                            <div class="section">
                                <h2>Formulardaten</h2>
                                <% renderObject(gespraech.formMetaData); %>
                            </div>
                            <% } else if (gespraech.formMetaData) { %>
                                <div class="section">
                                    <h2>Formulardaten</h2>
                                    <% renderObject(gespraech.formMetaData); %>
                                </div>
                                <% } %>

                                    <% if (gespraech.assessment && Object.keys(gespraech.assessment).length> 0) { %>
                                        <div class="section">
                                            <h2>Assessment</h2>
                                            <% renderObject(gespraech.assessment); %>
                                        </div>
                                        <% } %>

                                            <% if (gespraech.diagnosen && Array.isArray(gespraech.diagnosen) &&
                                                gespraech.diagnosen.length> 0) { %>
                                                <div class="section">
                                                    <h2>Diagnosen</h2>
                                                    <% gespraech.diagnosen.forEach(function(item) { %>
                                                        <div class="list-item">
                                                            <strong>
                                                                <%= item.code || 'Code unbekannt' %>
                                                            </strong>
                                                            <% if (item.description) { %> – <%= item.description %>
                                                                    <% } %>
                                                        </div>
                                                        <% }); %>
                                                </div>
                                                <% } %>

                                                    <% if (gespraech.ziele && Array.isArray(gespraech.ziele) &&
                                                        gespraech.ziele.length> 0) { %>
                                                        <div class="section">
                                                            <h2>Ziele</h2>
                                                            <% gespraech.ziele.forEach(function(ziel, index) { %>
                                                                <div class="subsection">
                                                                    <h3>Ziel <%= index + 1 %>
                                                                    </h3>
                                                                    <% Object.entries(ziel).forEach(function(entry) { %>
                                                                        <div class="field">
                                                                            <span class="field-label">
                                                                                <%= formatLabel(entry[0]) %>
                                                                            </span>
                                                                            <span class="field-value">
                                                                                <%= entry[1] ?? '-' %>
                                                                            </span>
                                                                        </div>
                                                                        <% }); %>
                                                                </div>
                                                                <% }); %>
                                                        </div>
                                                        <% } %>

                                                            <% if (gespraech.outcome &&
                                                                Object.keys(gespraech.outcome).length> 0) { %>
                                                                <div class="section">
                                                                    <h2>Outcome</h2>
                                                                    <% renderObject(gespraech.outcome); %>
                                                                </div>
                                                                <% } %>

                                                                    <% if (gespraech.notizen) { %>
                                                                        <div class="section">
                                                                            <h2>Notizen</h2>
                                                                            <div class="field-value">
                                                                                <%= gespraech.notizen %>
                                                                            </div>
                                                                        </div>
                                                                        <% } %>

                                                                            <div class="footer">
                                                                                <p>Dieses Dokument enthält die
                                                                                    wichtigsten Gesprächsinhalte in
                                                                                    einem kompakten Layout.</p>
                                                                            </div>
</body>

</html>