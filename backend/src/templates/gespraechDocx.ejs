<!DOCTYPE html>
<html lang="de">

<head>
    <meta charset="UTF-8">
    <title>Diätologisches Assessmentblatt</title>
</head>

<body style="margin: 0; padding: 0; background-color: #F8FBF8;">
    <%
        function hasValue(value) {
            return value !== null && value !== undefined && value !== "";
        }

        function formatDate(value) {
            if (!value) {
                return "Nicht angegeben";
            }

            return new Date(value).toLocaleDateString("de-DE");
        }

        function getClientName() {
            if (akte && akte.klarname && akte.klarname.name) {
                return akte.klarname.name;
            }

            return "Unbekannt";
        }

        function getElements(container) {
            if (!container) {
                return [];
            }

            if (Array.isArray(container.elements)) {
                return container.elements;
            }

            if (Array.isArray(container.fields)) {
                return container.fields;
            }

            if (Array.isArray(container)) {
                return container;
            }

            return [];
        }

        const formElements = getElements(gespraech.formMetaData);
        const assessmentElements = getElements(gespraech.assessment);
        const diagnosisElements = getElements(gespraech.diagnosen);
        const goalElements = getElements(gespraech.ziele);
        const outcomeElements = getElements(gespraech.outcome);

        function getAssessmentValue(formElement) {
            if (!formElement || !formElement.name) {
                return null;
            }

            const field = assessmentElements.find(function (entry) {
                return entry &&
                    entry.fieldName &&
                    entry.fieldName === formElement.name;
            });

            if (!field || field.value === null || field.value === undefined || field.value === "") {
                return null;
            }

            const raw = field.value;

            if (typeof raw === "boolean") {
                return raw ? "ja" : "nein";
            }

            if (typeof raw === "number") {
                return raw;
            }

            if (typeof raw === "string") {
                const lower = raw.toLowerCase();

                if (lower === "true") {
                    return "ja";
                }

                if (lower === "false") {
                    return "nein";
                }

                const option = formElement.options && formElement.options.find(function (opt) {
                    return opt.name === raw || opt.text === raw || opt.value === raw;
                });

                return option && option.text ? option.text : raw;
            }

            if (Array.isArray(raw)) {
                const values = raw
                    .map(function (item) {
                        if (!hasValue(item)) {
                            return null;
                        }

                        if (typeof item === "object") {
                            if (hasValue(item.text)) {
                                return item.text;
                            }

                            if (hasValue(item.name)) {
                                const option = formElement.options && formElement.options.find(function (opt) {
                                    return opt.name === item.name || opt.text === item.name || opt.value === item.name;
                                });

                                return option && option.text ? option.text : item.name;
                            }

                            if (hasValue(item.value)) {
                                return item.value;
                            }

                            return null;
                        }

                        return item;
                    })
                    .filter(function (item) {
                        return hasValue(item);
                    });

                return values.length > 0 ? values.join(", ") : null;
            }

            if (typeof raw === "object") {
                if (hasValue(raw.text)) {
                    return raw.text;
                }

                if (hasValue(raw.name)) {
                    const option = formElement.options && formElement.options.find(function (opt) {
                        return opt.name === raw.name || opt.text === raw.name || opt.value === raw.name;
                    });

                    return option && option.text ? option.text : raw.name;
                }

                if (hasValue(raw.value)) {
                    if (typeof raw.value === "boolean") {
                        return raw.value ? "ja" : "nein";
                    }

                    return raw.value;
                }

                return null;
            }

            return raw;
        }

        function buildCategoryItems(categoryNames) {
            return formElements
                .filter(function (element) {
                    return element &&
                        element.category &&
                        categoryNames.includes(element.category);
                })
                .map(function (element) {
                    return {
                        label: element.displayName || element.label || element.name || "Feld",
                        value: getAssessmentValue(element),
                    };
                })
                .filter(function (item) {
                    return hasValue(item.value);
                });
        }

        const categories = [
            {
                title: "Körperstrukturen/Körperfunktionen",
                keys: ["body"],
            },
            {
                title: "Aktivitäten",
                keys: ["activity"],
            },
            {
                title: "Partizipation",
                keys: ["participation", "behavior"],
            },
            {
                title: "Umweltfaktoren",
                keys: ["environment"],
            },
            {
                title: "Personenbezogene Faktoren",
                keys: ["personal"],
            },
        ];

        function getDiagnosisValue(diagnosis, keys) {
            for (let i = 0; i < keys.length; i++) {
                const key = keys[i];

                if (hasValue(diagnosis[key])) {
                    return diagnosis[key];
                }
            }

            return null;
        }

        function getGoalText(goal) {
            return goal.text || goal.ziel || goal.title || goal.titel || null;
        }

        function getGoalList(goal, key) {
            if (!goal[key]) {
                return [];
            }

            if (Array.isArray(goal[key])) {
                return goal[key];
            }

            return [goal[key]];
        }
    %>

    <div style="font-family: Calibri, Verdana, Arial, sans-serif; font-size: 11pt; line-height: 1.25; color: #222222; background-color: #F8FBF8;">

        <p align="center" style="font-family: Calibri, Verdana, Arial, sans-serif; font-size: 22pt; font-weight: bold; color: #245B2B; margin: 0 0 2px 0; padding: 0; text-align: center;"><% if (logoSrc) { %><img src="<%= logoSrc %>" alt="Logo" width="34" align="left" style="width: 34px; height: auto;"><% } %>Diätologisches Assessmentblatt</p>

        <p align="center" style="font-family: Calibri, Verdana, Arial, sans-serif; font-size: 10pt; color: #44505A; margin: 0 0 5px 0; padding: 0; text-align: center;">Exportiert am: <%= new Date(generatedAt).toLocaleString("de-DE") %></p>

        <div style="border-top: 4px solid #245B2B; height: 1px; margin: 0 0 12px 0;"></div>

        <div style="margin-bottom: 14px; text-align: left;">
            <p align="left" style="font-family: Calibri, Verdana, Arial, sans-serif; font-size: 12pt; color: #222222; margin: 0 0 8px 0; text-align: left;"><span style="font-weight: bold;">Klient/in: </span><span style="color: #44505A;"><%= getClientName() %></span></p>

            <p align="left" style="font-family: Calibri, Verdana, Arial, sans-serif; font-size: 12pt; color: #222222; margin: 0; text-align: left;"><span style="font-weight: bold;">Gesprächsdatum: </span><span style="color: #44505A;"><%= formatDate(gespraech.datum) %></span></p>
        </div>

        <% if (formElements.length > 0) { %>
            <p align="left" style="font-family: Calibri, Verdana, Arial, sans-serif; background-color: #245B2B; color: #FFFFFF; font-weight: bold; font-size: 13.5pt; padding: 8px 9px; margin: 0 0 8px 0; display: block; width: 100%; text-align: left;"><span style="display: block; text-align: left;">Assessment & Körperstrukturen</span></p>

            <p style="font-size: 6pt; line-height: 6pt; margin: 0;">&nbsp;</p>

            <% categories.forEach(function (category) { %>
                <%
                    const items = buildCategoryItems(category.keys);
                %>

                <div style="background-color: #FFFFFF; border: 1px solid #D8E4D8; margin-bottom: 10px;">
                    <p align="left" style="font-family: Calibri, Verdana, Arial, sans-serif; background-color: #EDF6EF; color: #245B2B; font-weight: bold; font-size: 12.5pt; padding: 7px 8px; margin: 0; border-bottom: 1px solid #D8E4D8; display: block; width: 100%; text-align: left;"><span style="display: block; text-align: left;"><%= category.title %></span></p>

                    <div style="padding: 8px; min-height: 18px;">
                        <% if (items.length > 0) { %>
                            <% items.forEach(function (item) { %>
                                <p align="left" style="font-family: Calibri, Verdana, Arial, sans-serif; background-color: #FFFFFF; border: 1px solid #D8E4D8; padding: 6px 7px; margin: 0 0 6px 0; text-align: left;"><span style="font-weight: bold; color: #222222;"><%= item.label %>: </span><span style="color: #222222;"><%= item.value %></span></p>
                            <% }); %>
                        <% } else { %>
                            <p align="left" style="font-family: Calibri, Verdana, Arial, sans-serif; color: #6B7280; margin: 0; text-align: left;">&nbsp;</p>
                        <% } %>
                    </div>
                </div>
            <% }); %>
        <% } %>

        <% if (diagnosisElements.length > 0) { %>
            <p align="left" style="font-family: Calibri, Verdana, Arial, sans-serif; background-color: #245B2B; color: #FFFFFF; font-weight: bold; font-size: 13.5pt; padding: 8px 9px; margin: 14px 0 14px 0; display: block; width: 100%; text-align: left;"><span style="display: block; text-align: left;">Diätologische Diagnose (P-E-S-F-B)</span></p>

            <% diagnosisElements.forEach(function (diagnosis, index) { %>
                <%
                    const problem = getDiagnosisValue(diagnosis, ["problem", "ernaehrungsproblem", "p"]);
                    const etiology = getDiagnosisValue(diagnosis, ["etiology", "ursache", "e"]);
                    const signs = getDiagnosisValue(diagnosis, ["signsAndSymptoms", "symptom", "symptome", "s"]);
                    const foerderfaktoren = getDiagnosisValue(diagnosis, ["foerderfaktoren", "foerderfaktor", "f"]);
                    const barrieren = getDiagnosisValue(diagnosis, ["barrieren", "barriere", "b"]);
                %>

                <div style="background-color: #EDF6EF; border-left: 5px solid #1D768F; padding: 10px; margin-bottom: 10px;">
                    <p align="left" style="font-family: Calibri, Verdana, Arial, sans-serif; font-weight: bold; font-size: 12pt; color: #222222; margin: 0 0 7px 0; text-align: left;">Diagnose <%= index + 1 %></p>

                    <% if (hasValue(problem)) { %>
                        <p align="left" style="font-family: Calibri, Verdana, Arial, sans-serif; background-color: #FFFFFF; border-top: 1px solid #D8E4D8; padding: 6px; margin: 0 0 4px 0; text-align: left;"><span style="font-weight: bold; color: #1D768F;">Ernährungsproblem (P): </span><span style="color: #222222;"><%= problem %></span></p>
                    <% } %>

                    <% if (hasValue(etiology)) { %>
                        <p align="left" style="font-family: Calibri, Verdana, Arial, sans-serif; background-color: #FFFFFF; border-top: 1px solid #D8E4D8; padding: 6px; margin: 0 0 4px 0; text-align: left;"><span style="font-weight: bold; color: #1D768F;">Ursache (E): </span><span style="color: #222222;"><%= etiology %></span></p>
                    <% } %>

                    <% if (hasValue(signs)) { %>
                        <p align="left" style="font-family: Calibri, Verdana, Arial, sans-serif; background-color: #FFFFFF; border-top: 1px solid #D8E4D8; padding: 6px; margin: 0 0 4px 0; text-align: left;"><span style="font-weight: bold; color: #1D768F;">Symptom/Anzeichen (S): </span><span style="color: #222222;"><%= signs %></span></p>
                    <% } %>

                    <% if (hasValue(foerderfaktoren)) { %>
                        <p align="left" style="font-family: Calibri, Verdana, Arial, sans-serif; background-color: #FFFFFF; border-top: 1px solid #D8E4D8; padding: 6px; margin: 0 0 4px 0; text-align: left;"><span style="font-weight: bold; color: #1D768F;">Förderfaktor (F): </span><span style="color: #222222;"><%= foerderfaktoren %></span></p>
                    <% } %>

                    <% if (hasValue(barrieren)) { %>
                        <p align="left" style="font-family: Calibri, Verdana, Arial, sans-serif; background-color: #FFFFFF; border-top: 1px solid #D8E4D8; padding: 6px; margin: 0; text-align: left;"><span style="font-weight: bold; color: #1D768F;">Barrieren (B): </span><span style="color: #222222;"><%= barrieren %></span></p>
                    <% } %>
                </div>
            <% }); %>
        <% } %>

        <% if (goalElements.length > 0) { %>
            <p align="left" style="font-family: Calibri, Verdana, Arial, sans-serif; background-color: #245B2B; color: #FFFFFF; font-weight: bold; font-size: 13.5pt; padding: 8px 9px; margin: 14px 0 14px 0; display: block; width: 100%; text-align: left;"><span style="display: block; text-align: left;">Diätologische Ziele</span></p>

            <% goalElements.forEach(function (goal, index) { %>
                <%
                    const goalText = getGoalText(goal);
                    const handlungsziele = getGoalList(goal, "handlungsziele");
                    const massnahmenziele = getGoalList(goal, "massnahmenziele");
                %>

                <div style="background-color: #F0F8FF; border-left: 5px solid #A7C0A5; padding: 10px; margin-bottom: 10px;">
                    <p align="left" style="font-family: Calibri, Verdana, Arial, sans-serif; font-weight: bold; font-size: 12pt; color: #222222; margin: 0 0 7px 0; text-align: left;">Interventionsziel <%= index + 1 %></p>

                    <% if (hasValue(goalText)) { %>
                        <p align="left" style="font-family: Calibri, Verdana, Arial, sans-serif; color: #222222; margin: 0 0 4px 12px; text-align: left;"><strong>Ziel: </strong><%= goalText %></p>
                    <% } %>

                    <% if (handlungsziele.length > 0) { %>
                        <p align="left" style="font-family: Calibri, Verdana, Arial, sans-serif; font-weight: bold; color: #245B2B; margin: 6px 0 3px 0; text-align: left;">Handlungsziele:</p>

                        <% handlungsziele.forEach(function (handlungsziel) { %>
                            <p align="left" style="font-family: Calibri, Verdana, Arial, sans-serif; color: #222222; margin: 0 0 3px 12px; text-align: left;">• <%= handlungsziel.text || handlungsziel %></p>
                        <% }); %>
                    <% } %>

                    <% if (massnahmenziele.length > 0) { %>
                        <p align="left" style="font-family: Calibri, Verdana, Arial, sans-serif; font-weight: bold; color: #245B2B; margin: 6px 0 3px 0; text-align: left;">Maßnahmenziele:</p>

                        <% massnahmenziele.forEach(function (massnahmenziel) { %>
                            <p align="left" style="font-family: Calibri, Verdana, Arial, sans-serif; color: #222222; margin: 0 0 3px 12px; text-align: left;">• <%= massnahmenziel.text || massnahmenziel %></p>
                        <% }); %>
                    <% } %>
                </div>
            <% }); %>
        <% } %>

        <% if (outcomeElements.length > 0) { %>
            <p align="left" style="font-family: Calibri, Verdana, Arial, sans-serif; background-color: #245B2B; color: #FFFFFF; font-weight: bold; font-size: 13.5pt; padding: 8px 9px; margin: 14px 0 14px 0; display: block; width: 100%; text-align: left;"><span style="display: block; text-align: left;">Outcomes & Ergebnisse</span></p>

            <% outcomeElements.forEach(function (outcome, index) { %>
                <div style="background-color: #F0F8FF; border-left: 5px solid #A7C0A5; padding: 10px; margin-bottom: 10px;">
                    <p align="left" style="font-family: Calibri, Verdana, Arial, sans-serif; font-weight: bold; color: #222222; margin: 0 0 5px 0; text-align: left;">Ziel <%= index + 1 %>
                        <% if (typeof outcome.success === "number") { %>
                            – Erfolg: <%= outcome.success > 1 ? outcome.success : outcome.success * 100 %>%
                        <% } else { %>
                            – Erfolg: Nicht bewertet
                        <% } %>
                    </p>

                    <% if (hasValue(outcome.text)) { %>
                        <p align="left" style="font-family: Calibri, Verdana, Arial, sans-serif; color: #222222; margin: 0 0 0 12px; text-align: left;"><%= outcome.text %></p>
                    <% } %>
                </div>
            <% }); %>
        <% } %>

        <% if (gespraech.notizen) { %>
            <p align="left" style="font-family: Calibri, Verdana, Arial, sans-serif; background-color: #245B2B; color: #FFFFFF; font-weight: bold; font-size: 13.5pt; padding: 8px 9px; margin: 14px 0 14px 0; display: block; width: 100%; text-align: left;"><span style="display: block; text-align: left;">Notizen</span></p>

            <div style="background-color: #FFFBE6; border-left: 5px solid #FBC02D; padding: 10px; color: #222222;">
                <p style="font-family: Calibri, Verdana, Arial, sans-serif; margin: 0;"><%= gespraech.notizen %></p>
            </div>
        <% } %>

        <p style="font-family: Calibri, Verdana, Arial, sans-serif; margin-top: 18px; padding-top: 8px; border-top: 1px solid #D8E4D8; color: #44505A; font-size: 9.5pt; text-align: center;">
            Dieses Assessmentblatt wurde automatisch generiert und folgt dem Standard der diätologischen Praxis.
        </p>
    </div>
</body>

</html>