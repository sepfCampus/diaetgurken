<!DOCTYPE html>
<html lang="de">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Diätologisches Assessmentblatt</title>
    <style>
        :root {
            --primary-color: <%=colors.PRIMARY %>;
            --secondary-color: <%=colors.SECONDARY %>;
            --tertiary-color: <%=colors.TERTIARY %>;
            --quaternary-color: <%=colors.QUATERNARY %>;
            --card-background: <%=colors.CARD_BACKGROUND %>;
            --page-background: <%=colors.PAGE_BACKGROUND %>;
            --text-color: <%=colors.TEXT %>;
            --muted-text: <%=colors.MUTED_TEXT %>;
            --border-color: <%=colors.BORDER %>;
            --font-scale: <%=fontScale || 1 %>;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            background-color: var(--page-background);
            color: var(--text-color);
            font-size: calc(0.95rem * var(--font-scale));
            line-height: 1.3;
            padding: calc(10mm * var(--font-scale));
        }

        .header {
            border-bottom: 3px solid var(--primary-color);
            padding-bottom: calc(8px * var(--font-scale));
            margin-bottom: calc(12px * var(--font-scale));
            position: relative;
        }

        .header h1 {
            color: var(--primary-color);
            margin: 0;
            font-size: calc(1.5rem * var(--font-scale));
            font-weight: bold;
        }

        .header p {
            margin: calc(4px * var(--font-scale)) 0 0;
            font-size: calc(0.85rem * var(--font-scale));
            color: var(--muted-text);
        }

        .logo {
            position: absolute;
            top: 0;
            right: 0;
            max-width: calc(100px * var(--font-scale));
            max-height: calc(50px * var(--font-scale));
        }

        .meta-info {
            background-color: var(--card-background);
            padding: calc(10px * var(--font-scale));
            border-left: 4px solid var(--primary-color);
            margin-bottom: calc(12px * var(--font-scale));
        }

        .meta-heading {
            color: var(--primary-color);
            font-size: calc(1rem * var(--font-scale));
            margin-bottom: calc(8px * var(--font-scale));
        }

        .meta-row {
            display: flex;
            gap: calc(20px * var(--font-scale));
            margin-bottom: calc(6px * var(--font-scale));
        }

        .meta-field {
            flex: 1;
        }

        .meta-label {
            font-weight: bold;
            color: var(--text-color);
            font-size: calc(0.9rem * var(--font-scale));
        }

        .meta-value {
            color: var(--muted-text);
            font-size: calc(0.85rem * var(--font-scale));
            margin: calc(2px * var(--font-scale)) 0 0;
        }

        .section {
            margin-bottom: calc(14px * var(--font-scale));
            break-inside: auto;
            page-break-inside: auto;
        }

        .section-title {
            background-color: var(--primary-color);
            color: white;
            padding: calc(8px * var(--font-scale));
            font-weight: bold;
            font-size: calc(1rem * var(--font-scale));
            margin-bottom: calc(8px * var(--font-scale));
            border-radius: calc(3px * var(--font-scale));
            break-after: avoid;
            page-break-after: avoid;
        }

        /* Tabellen */
        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: calc(10px * var(--font-scale));
            background-color: white;
            border: 1px solid var(--border-color);
        }

        table th {
            background-color: var(--quaternary-color);
            color: white;
            padding: calc(8px * var(--font-scale));
            text-align: left;
            font-weight: bold;
            font-size: calc(0.9rem * var(--font-scale));
            border: 1px solid var(--border-color);
        }

        table td {
            padding: calc(8px * var(--font-scale));
            border: 1px solid var(--border-color);
            font-size: calc(0.85rem * var(--font-scale));
            vertical-align: top;
        }

        table tr:nth-child(even) {
            background-color: rgba(237, 246, 239, 0.5);
        }

        /* Assessment Kategorien */
        .category-body {
            background-color: #e8f4f8;
        }

        .category-activity {
            background-color: #fffde7;
        }

        .category-participation {
            background-color: #f3e5f5;
        }

        .category-environment {
            background-color: #e8f5e9;
        }

        .category-personal {
            background-color: #fce4ec;
        }

        .category-label {
            font-weight: bold;
            font-size: calc(0.8rem * var(--font-scale));
            display: inline-block;
            padding: calc(2px * var(--font-scale)) calc(6px * var(--font-scale));
            border-radius: calc(2px * var(--font-scale));
            margin-bottom: calc(4px * var(--font-scale));
        }

        .assessment-grid {
            display: grid;
            grid-template-columns: 1.8fr 1.0fr 1.0fr;
            gap: calc(10px * var(--font-scale));
            margin-bottom: calc(10px * var(--font-scale));
        }

        .assessment-grid-wide {
            display: grid;
            grid-template-columns: 1.3fr 1.3fr;
            gap: calc(10px * var(--font-scale));
        }

        .assessment-column,
        .assessment-column-wide {
            background-color: white;
            padding: calc(10px * var(--font-scale));
            border: 1px solid var(--border-color);
            border-radius: calc(4px * var(--font-scale));
            min-height: calc(120px * var(--font-scale));
            break-inside: auto;
            page-break-inside: auto;
        }

        .assessment-column-title {
            font-weight: bold;
            font-size: calc(0.95rem * var(--font-scale));
            margin-bottom: calc(10px * var(--font-scale));
            color: var(--primary-color);
        }

        .assessment-item {
            margin-bottom: calc(8px * var(--font-scale));
            line-height: 1.4;
            color: var(--text-color);
            font-size: calc(0.9rem * var(--font-scale));
            overflow-wrap: anywhere;
            word-break: normal;
        }

        .assessment-item strong {
            color: var(--text-color);
        }

        .large-font .assessment-grid,
        .large-font .assessment-grid-wide {
            display: block;
        }

        .large-font .assessment-column,
        .large-font .assessment-column-wide {
            margin-bottom: calc(10px * var(--font-scale));
            min-height: 0;
        }

        /* Diagnosen PESB */
        .diagnosis-item {
            background-color: var(--card-background);
            padding: calc(10px * var(--font-scale));
            margin-bottom: calc(10px * var(--font-scale));
            border-left: 4px solid var(--quaternary-color);
            border-radius: calc(2px * var(--font-scale));
        }

        .diagnosis-pesb {
            display: flex;
            flex-wrap: wrap;
            gap: calc(8px * var(--font-scale));
            align-items: flex-start;
            padding-bottom: calc(8px * var(--font-scale));
            border-bottom: 1px solid var(--border-color);
        }

        .diagnosis-pesb:last-child {
            border-bottom: none;
            padding-bottom: 0;
            margin-bottom: 0;
        }

        .diagnosis-pesb-label {
            font-weight: bold;
            color: var(--quaternary-color);
            font-size: calc(0.85rem * var(--font-scale));
            width: calc(180px * var(--font-scale));
            flex: 0 0 calc(180px * var(--font-scale));
            white-space: nowrap;
        }

        .diagnosis-pesb-value {
            color: var(--text-color);
            font-size: calc(0.85rem * var(--font-scale));
            flex: 1;
            min-width: 0;
        }

        /* Ziele */
        .goal-item {
            background-color: #f0f8ff;
            padding: calc(10px * var(--font-scale));
            margin-bottom: calc(10px * var(--font-scale));
            border-left: 4px solid var(--secondary-color);
            border-radius: calc(2px * var(--font-scale));
        }

        .goal-type {
            font-weight: bold;
            color: var(--secondary-color);
            font-size: calc(0.9rem * var(--font-scale));
            margin-top: calc(6px * var(--font-scale));
            margin-bottom: calc(4px * var(--font-scale));
        }

        .goal-text {
            color: var(--text-color);
            font-size: calc(0.85rem * var(--font-scale));
            margin-left: calc(12px * var(--font-scale));
            padding-bottom: calc(4px * var(--font-scale));
        }

        .goal-list {
            margin: 0 0 calc(6px * var(--font-scale)) calc(28px * var(--font-scale));
            color: var(--text-color);
            font-size: calc(0.85rem * var(--font-scale));
        }

        .goal-list li {
            margin-bottom: calc(4px * var(--font-scale));
        }

        /* Outcome */
        .outcome-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: calc(10px * var(--font-scale));
            margin-bottom: calc(10px * var(--font-scale));
        }

        .outcome-card {
            background-color: var(--card-background);
            padding: calc(10px * var(--font-scale));
            border: 1px solid var(--border-color);
            border-radius: calc(3px * var(--font-scale));
        }

        .outcome-label {
            font-weight: bold;
            color: var(--quaternary-color);
            font-size: calc(0.9rem * var(--font-scale));
            margin-bottom: calc(4px * var(--font-scale));
        }

        .outcome-value {
            color: var(--text-color);
            font-size: calc(1rem * var(--font-scale));
            font-weight: bold;
        }

        /* Notizen */
        .notes {
            background-color: #fffbe6;
            padding: calc(10px * var(--font-scale));
            border-radius: calc(3px * var(--font-scale));
            border-left: 4px solid #fbc02d;
            font-size: calc(0.85rem * var(--font-scale));
            color: var(--text-color);
        }

        .footer {
            margin-top: calc(20px * var(--font-scale));
            padding-top: calc(10px * var(--font-scale));
            border-top: 1px solid var(--border-color);
            font-size: calc(0.8rem * var(--font-scale));
            color: var(--muted-text);
            text-align: center;
        }

        .no-data {
            color: var(--muted-text);
            font-style: italic;
            font-size: calc(0.85rem * var(--font-scale));
        }

        @media print {
            body {
                padding: 0;
            }

            .section {
                break-inside: auto;
                page-break-inside: auto;
            }
        }
    </style>
</head>

<body class="<%= fontScale > 1 ? 'large-font' : '' %>">
    <div class="header">
        <h1>Diätologisches Assessmentblatt</h1>
        <p>Exportiert am: <%= new Date(generatedAt).toLocaleString('de-DE') %>
        </p>
        <% if (logoSrc) { %>
            <img src="<%= logoSrc %>" alt="Logo" class="logo">
            <% } %>
    </div>

    <div>

    <!-- Meta-Informationen -->
    <div class="meta-info">
        <h2 id="stammdaten-heading" class="meta-heading">Stammdaten</h2>
        <div class="meta-row">
            <div class="meta-field">
                <p class="meta-label">Klient/in</p>
                <p class="meta-value">
                    <%= akte?.klarname?.name || 'Unbekannt' %>
                </p>
            </div>
            <div class="meta-field">
                <p class="meta-label">Gesprächsdatum</p>
                <p class="meta-value">
                    <%= new Date(gespraech.datum).toLocaleDateString('de-DE') %>
                </p>
            </div>
        </div>
    </div>

    <!-- ASSESSMENT SEKTION -->
    <% if (gespraech.formMetaData && gespraech.formMetaData.elements && gespraech.formMetaData.elements.length> 0) { %>
        <% function assessmentDisplayValue(el) { const field=gespraech.assessment?.elements?.find(a=> a.fieldName ===
            el.name);
            if (!field || field.value == null || field.value === '') return null;
            const raw = field.value;

            if (typeof raw === 'object') {
            if (raw.text) return raw.text;
            if (raw.name) {
            const opt = el.options?.find(o => o.name === raw.name);
            return opt?.text || raw.name;
            }
            if (typeof raw.value === 'boolean') return raw.value ? 'ja' : 'nein';
            return JSON.stringify(raw);
            }

            if (typeof raw === 'boolean') {
            return raw ? 'ja' : 'nein';
            }

            if (typeof raw === 'string') {
            const lower = raw.toLowerCase();
            if (lower === 'true' || lower === 'false') return lower === 'true' ? 'ja' : 'nein';
            const option = el.options?.find(o => o.name === raw || o.text === raw);
            return option?.text || raw;
            }

            return raw;
            } %>
            <div class="section">
                <h2 id="assessment-heading" class="section-title">Assessment & Körperstrukturen</h2>

                <div class="assessment-grid">
                    <div class="assessment-column category-body">
                        <h3 class="assessment-column-title">Körperstrukturen/Körperfunktionen</h3>
                        <% gespraech.formMetaData.elements.forEach(el=> {
                            if (el.category === 'body') {
                            const displayValue = assessmentDisplayValue(el);
                            if (displayValue) { %>
                            <div class="assessment-item">
                                <strong>
                                    <%= el.displayName || el.name %>:
                                </strong>
                                <span>
                                    <%= displayValue %>
                                </span>
                            </div>
                            <% } } }); %>
                    </div>
                    <div class="assessment-column category-activity">
                        <h3 class="assessment-column-title">Aktivitäten</h3>
                        <% gespraech.formMetaData.elements.forEach(el=> {
                            if (el.category === 'activity') {
                            const displayValue = assessmentDisplayValue(el);
                            if (displayValue) { %>
                            <div class="assessment-item">
                                <strong>
                                    <%= el.displayName || el.name %>:
                                </strong>
                                <span>
                                    <%= displayValue %>
                                </span>
                            </div>
                            <% } } }); %>
                    </div>
                    <div class="assessment-column category-participation">
                        <h3 class="assessment-column-title">Partizipation</h3>
                        <% gespraech.formMetaData.elements.forEach(el=> {
                            if (el.category === 'participation' || el.category === 'behavior') {
                            const displayValue = assessmentDisplayValue(el);
                            if (displayValue) { %>
                            <div class="assessment-item">
                                <strong>
                                    <%= el.displayName || el.name %>:
                                </strong>
                                <span>
                                    <%= displayValue %>
                                </span>
                            </div>
                            <% } } }); %>
                    </div>
                </div>

                <div class="assessment-grid assessment-grid-wide">
                    <div class="assessment-column-wide category-environment">
                        <h3 class="assessment-column-title">Umweltfaktoren</h3>
                        <% gespraech.formMetaData.elements.forEach(el=> {
                            if (el.category === 'environment') {
                            const displayValue = assessmentDisplayValue(el);
                            if (displayValue) { %>
                            <div class="assessment-item">
                                <strong>
                                    <%= el.displayName || el.name %>:
                                </strong>
                                <span>
                                    <%= displayValue %>
                                </span>
                            </div>
                            <% } } }); %>
                    </div>
                    <div class="assessment-column-wide category-personal">
                        <h3 class="assessment-column-title">Personenbezogene Faktoren</h3>
                        <% gespraech.formMetaData.elements.forEach(el=> {
                            if (el.category === 'personal') {
                            const displayValue = assessmentDisplayValue(el);
                            if (displayValue) { %>
                            <div class="assessment-item">
                                <strong>
                                    <%= el.displayName || el.name %>:
                                </strong>
                                <span>
                                    <%= displayValue %>
                                </span>
                            </div>
                            <% } } }); %>
                    </div>
                </div>
            </div>
            <% } %>

                <!-- DIAGNOSEN SEKTION -->
                <% if (gespraech.diagnosen && gespraech.diagnosen.elements && gespraech.diagnosen.elements.length> 0) {
                    %>
                    <div class="section">
                        <h2 id="diagnosen-heading" class="section-title">Diätologische Diagnose (P-E-S-F-B)</h2>

                        <% gespraech.diagnosen.elements.forEach((diag, idx)=> { %>
                            <div class="diagnosis-item">
                                <h3
                                    style="font-size: calc(0.95rem * var(--font-scale)); margin-bottom: calc(8px * var(--font-scale)); display: block;">
                                    Diagnose <%= idx + 1 %>
                                </h3>

                                <% if (diag.problem) { %>
                                    <div class="diagnosis-pesb">
                                        <div class="diagnosis-pesb-label">Ernährungsproblem (P):</div>
                                        <div class="diagnosis-pesb-value">
                                            <%= diag.problem %>
                                        </div>
                                    </div>
                                    <% } %>

                                        <% if (diag.etiology) { %>
                                            <div class="diagnosis-pesb">
                                                <div class="diagnosis-pesb-label">Ursache (E):</div>
                                                <div class="diagnosis-pesb-value">
                                                    <%= diag.etiology %>
                                                </div>
                                            </div>
                                            <% } %>

                                                <% if (diag.signsAndSymptoms) { %>
                                                    <div class="diagnosis-pesb">
                                                        <div class="diagnosis-pesb-label">Symptom/Anzeichen (S):</div>
                                                        <div class="diagnosis-pesb-value">
                                                            <%= diag.signsAndSymptoms %>
                                                        </div>
                                                    </div>
                                                    <% } %>

                                                        <% if (diag.foerderfaktoren) { %>
                                                            <div class="diagnosis-pesb">
                                                                <div class="diagnosis-pesb-label">Förderfaktor (F):
                                                                </div>
                                                                <div class="diagnosis-pesb-value">
                                                                    <%= diag.foerderfaktoren %>
                                                                </div>
                                                            </div>
                                                            <% } %>

                                                                <% if (diag.barrieren) { %>
                                                                    <div class="diagnosis-pesb">
                                                                        <div class="diagnosis-pesb-label">Barrieren (B):
                                                                        </div>
                                                                        <div class="diagnosis-pesb-value">
                                                                            <%= diag.barrieren %>
                                                                        </div>
                                                                    </div>
                                                                    <% } %>
                            </div>
                            <% }); %>
                    </div>
                    <% } %>

                        <!-- ZIELE SEKTION -->
                        <% if (gespraech.ziele && gespraech.ziele.elements && gespraech.ziele.elements.length> 0) { %>
                            <div class="section">
                                <h2 id="ziele-heading" class="section-title">Diätologische Ziele</h2>

                                <% gespraech.ziele.elements.forEach((ziel, idx)=> { %>
                                    <div class="goal-item">
                                        <h3
                                            style="font-size: calc(0.95rem * var(--font-scale)); display: block; margin-bottom: calc(6px * var(--font-scale));">
                                            Interventionsziel <%= idx + 1 %>
                                        </h3>

                                        <% if (ziel.text) { %>
                                            <div class="goal-text"><strong>Ziel:</strong>
                                                <%= ziel.text %>
                                            </div>
                                            <% } %>

                                                <% if (ziel.handlungsziele && ziel.handlungsziele.length> 0) { %>
                                                    <h4 class="goal-type">Handlungsziele</h4>
                                                    <ul class="goal-list">
                                                    <% ziel.handlungsziele.forEach(hz=> { %>
                                                        <li><%= hz.text || hz %></li>
                                                        <% }); %>
                                                    </ul>
                                                            <% } %>

                                                                <% if (ziel.massnahmenziele &&
                                                                    ziel.massnahmenziele.length>
                                                                    0) { %>
                                                                    <h4 class="goal-type">Massnahmenziele</h4>
                                                                    <ul class="goal-list">
                                                                    <% ziel.massnahmenziele.forEach(mz=> { %>
                                                                        <li><%= mz.text || mz %></li>
                                                                        <% }); %>
                                                                    </ul>
                                                                            <% } %>
                                    </div>
                                    <% }); %>
                            </div>
                            <% } %>

                                <!-- OUTCOME SEKTION -->
                                <% if (gespraech.outcome && gespraech.outcome.elements &&
                                    gespraech.outcome.elements.length>
                                    0) { %>
                                    <div class="section">
                                        <h2 id="outcomes-heading" class="section-title">Outcomes & Ergebnisse</h2>

                                        <% gespraech.outcome.elements.forEach((out, idx)=> { %>
                                            <div class="goal-item">
                                                <h3
                                                    style="font-size: calc(0.95rem * var(--font-scale)); margin-bottom: calc(6px * var(--font-scale)); display: block;">
                                                    Ziel <%= idx + 1 %> – Erfolg: <%= typeof out.success==='number' ?
                                                            ((out.success> 1 ? out.success : out.success * 100) + '%') :
                                                            'Nicht bewertet' %>
                                                </h3>

                                                <% if (out.text) { %>
                                                    <div class="goal-text">
                                                        <%= out.text %>
                                                    </div>
                                                    <% } %>
                                            </div>
                                            <% }); %>
                                    </div>
                                    <% } %>

                                        <!-- NOTIZEN SEKTION -->
                                        <% if (gespraech.notizen) { %>
                                            <div class="section">
                                                <h2 id="notizen-heading" class="section-title">Notizen</h2>
                                                <div class="notes">
                                                    <%= gespraech.notizen %>
                                                </div>
                                            </div>
                                            <% } %>

                                                </div>

                                                <div class="footer">
                                                    <p>Dieses Assessmentblatt wurde automatisch generiert und folgt dem
                                                        Standard der diätologischen Praxis.</p>
                                                </div>
</body>

</html>
